{
  "name": "tool_pkgreg_diff_two_versions",
  "description": "Show which files changed between two published versions.",
  "task_type": "tool_use",
  "domain": "package_registry",
  "difficulty": 1,
  "tags": ["tool-use", "package_registry", "diff"],
  "tool_service": "package_registry",
