{
  "name": "tool_forge_inspect_commit_history",
  "description": "List commit history, then show the full details of one specific commit.",
  "task_type": "tool_use",
  "domain": "forge",
  "difficulty": 1,
  "tags": ["tool-use", "forge", "repositories", "commits"],
  "tool_service": "forge",
  "tools": ["list_commits", "get_commit"],
  "tool_service_seed": {
