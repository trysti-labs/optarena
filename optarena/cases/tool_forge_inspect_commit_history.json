  },
  "prompts": [
    "List the commit history for acme/webapp, then show me the full details of the initial commit (sha1)."
  ],
  "expected_calls": [
    {"tool": "list_commits", "arguments_contains": {"owner": "acme", "repo": "webapp"}},
    {"tool": "get_commit", "arguments_contains": {"owner": "acme", "repo": "webapp", "sha": "sha1"}}
  ]
