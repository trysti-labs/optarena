{
  "name": "tool_forge_open_pr_for_fix",
  "description": "Open a new pull request between two existing branches.",
  "task_type": "tool_use",
  "domain": "forge",
  "difficulty": 1,
  "tags": ["tool-use", "forge", "pull-requests"],
  "tool_service": "forge",
  "tools": ["create_pull_request"],
  "tool_service_seed": {
    "branches": {"acme/webapp": {"feature-fix": "sha-fix-0"}}
