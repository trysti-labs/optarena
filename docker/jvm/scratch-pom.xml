<?xml version="1.0" encoding="UTF-8"?>
<!--
  Warms the shared ~/.m2 cache at image build time so case authors' own
  pom.xml files (using these same spring-boot-starter-* versions) can build
  and test fully offline, since check_command runs with networking disabled.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- P1-03: was 3.3.4 - bumped to the latest 3.5.x (same major, within
         Spring's own minor-version compatibility promise) to pick up
         patched tomcat-embed-core/jackson-databind/commons-io versions.
         Every case's own embedded pom.xml pins this SAME version (checked:
         54 case files) so the pre-warmed ~/.m2 cache below still resolves
         their offline builds - both had to move together. -->
    <version>3.5.16</version>
  </parent>
  <groupId>com.optarena</groupId>
  <artifactId>warmup</artifactId>
  <version>1.0.0</version>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
