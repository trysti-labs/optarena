<?xml version="1.0" encoding="utf-8"?>
<!--
  Installed as the global NuGet.Config after the warmup restore. The global
  packages folder doubles as a v3-compatible local feed (same lowercase
  id/version/nupkg layout NuGet expects of a folder source), so pointing the
  ONLY source at it lets `dotnet restore` succeed fully offline for any
  project pinned to package versions already warmed into the cache.
  nuget.org is deliberately not listed, so a genuinely uncached package
  fails fast instead of hanging on a network the sandbox disables.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="/root/.nuget/packages" />
  </packageSources>
</configuration>
